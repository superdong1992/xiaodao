{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiaodao.local/schemas/evidence-v2/core-verdict.schema.json",
  "title": "Evidence V2 Core verdict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_type",
    "status",
    "execution_mode",
    "model_invocations",
    "source_snapshot_digest",
    "contract_manifest",
    "core_cases",
    "pytest"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "receipt_type": { "const": "evidence-v2-core" },
    "status": { "const": "PASS" },
    "execution_mode": { "const": "deterministic-zero-model" },
    "model_invocations": { "const": 0 },
    "source_snapshot_digest": { "$ref": "#/$defs/sha256" },
    "contract_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "const": "schemas/v2/contract-manifest.json" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "core_cases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selectors", "count", "sha256"],
      "properties": {
        "selectors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "count": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "pytest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary_path", "summary_sha256", "junit_path", "junit_sha256", "counts"],
      "properties": {
        "summary_path": { "const": "pytest-summary.json" },
        "summary_sha256": { "$ref": "#/$defs/sha256" },
        "junit_path": { "const": "pytest.xml" },
        "junit_sha256": { "$ref": "#/$defs/sha256" },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tests", "passed", "failures", "errors", "skipped", "executed"],
          "properties": {
            "tests": { "type": "integer", "minimum": 1 },
            "passed": { "type": "integer", "minimum": 1 },
            "failures": { "const": 0 },
            "errors": { "const": 0 },
            "skipped": { "const": 0 },
            "executed": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
