{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiaodao.local/schemas/evidence-v2/model-cert-input.schema.json",
  "title": "Evidence V2 model certification adapter input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_type",
    "status",
    "evaluation_mode",
    "certification_target",
    "source_snapshot_digest",
    "contract_manifest",
    "core_verdict",
    "scenario_oracle",
    "scenario",
    "provider",
    "model",
    "execution_identity",
    "invocations",
    "call_counts",
    "usage",
    "methods_result"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "receipt_type": { "const": "evidence-v2-model-cert-input" },
    "status": { "const": "PASS" },
    "evaluation_mode": { "enum": ["SPECIALIST_ONLY", "BLIND_CONSENSUS"] },
    "certification_target": { "enum": ["P1", "P2"] },
    "source_snapshot_digest": { "$ref": "#/$defs/sha256" },
    "contract_manifest": { "$ref": "#/$defs/manifestBinding" },
    "core_verdict": { "$ref": "#/$defs/coreBinding" },
    "scenario_oracle": { "$ref": "#/$defs/scenarioOracleBinding" },
    "scenario": { "$ref": "#/$defs/scenario" },
    "provider": { "$ref": "#/$defs/provider" },
    "model": { "$ref": "#/$defs/model" },
    "execution_identity": { "$ref": "#/$defs/executionIdentity" },
    "invocations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/invocation" }
    },
    "call_counts": { "$ref": "#/$defs/callCounts" },
    "usage": { "$ref": "#/$defs/usage" },
    "methods_result": { "$ref": "#/$defs/methodsResult" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "certification_target": { "const": "P1" } },
        "required": ["certification_target"]
      },
      "then": {
        "properties": {
          "provider": {
            "properties": {
              "id": { "const": "deepseek" },
              "transport": { "const": "claude-code-compatible-api" }
            }
          },
          "model": {
            "properties": {
              "id": { "const": "deepseek-v4-flash[1m]" },
              "revision": { "$ref": "#/$defs/sha256" },
              "revision_source": { "const": "settings-fingerprint" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "certification_target": { "const": "P2" } },
        "required": ["certification_target"]
      },
      "then": {
        "properties": {
          "provider": {
            "properties": {
              "id": { "const": "openai" },
              "transport": { "const": "codex-app-server" }
            }
          },
          "model": {
            "properties": {
              "id": { "const": "gpt-5.6-luna" },
              "revision": { "$ref": "#/$defs/sha256" },
              "revision_source": { "const": "frozen-codex-cli-and-app-server-runtime-identity" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "evaluation_mode": { "const": "SPECIALIST_ONLY" } },
        "required": ["evaluation_mode"]
      },
      "then": { "$ref": "#/$defs/specialistOnlyTopology" }
    },
    {
      "if": {
        "properties": { "evaluation_mode": { "const": "BLIND_CONSENSUS" } },
        "required": ["evaluation_mode"]
      },
      "then": { "$ref": "#/$defs/blindConsensusTopology" }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nonEmpty": {
      "type": "string",
      "minLength": 1
    },
    "identityBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "manifestBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "const": "schemas/v2/contract-manifest.json" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "coreBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "const": "payload/stages/deterministic.full/gates/det.evidence-v2-core/core-verdict.json" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "scenarioOracleBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "const": "scenario-oracle-receipt.json" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "source_wiki_sha256",
        "registration_id",
        "skill_content_sha256",
        "user_inputs_sha256",
        "sources",
        "evidence_graph",
        "evaluation_plan"
      ],
      "properties": {
        "scenario_id": { "const": "multiple-rpc-timeouts" },
        "source_wiki_sha256": { "$ref": "#/$defs/sha256" },
        "registration_id": { "$ref": "#/$defs/nonEmpty" },
        "skill_content_sha256": { "$ref": "#/$defs/sha256" },
        "user_inputs_sha256": { "$ref": "#/$defs/sha256" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/scenarioSource" }
        },
        "evidence_graph": { "$ref": "#/$defs/evidenceGraphIdentity" },
        "evaluation_plan": { "$ref": "#/$defs/evaluationPlanIdentity" }
      }
    },
    "scenarioSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "content_sha256"],
      "properties": {
        "source_id": { "$ref": "#/$defs/nonEmpty" },
        "content_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "evidenceGraphIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "canonical_sha256", "canonical_size"],
      "properties": {
        "ref": { "type": "string", "pattern": "^graph-[a-f0-9]{64}$" },
        "canonical_sha256": { "$ref": "#/$defs/sha256" },
        "canonical_size": { "type": "integer", "minimum": 1 }
      }
    },
    "evaluationPlanIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "canonical_sha256", "canonical_size"],
      "properties": {
        "ref": { "type": "string", "pattern": "^plan-[a-f0-9]{64}$" },
        "canonical_sha256": { "$ref": "#/$defs/sha256" },
        "canonical_size": { "type": "integer", "minimum": 1 }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "transport"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" },
        "transport": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "revision_source"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" },
        "revision": { "$ref": "#/$defs/nonEmpty" },
        "revision_source": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "executionIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "prompt_policy", "profile", "tool_policy"],
      "properties": {
        "runtime": { "$ref": "#/$defs/identityBinding" },
        "prompt_policy": { "$ref": "#/$defs/identityBinding" },
        "profile": { "$ref": "#/$defs/identityBinding" },
        "tool_policy": { "$ref": "#/$defs/identityBinding" }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "input_tokens",
        "output_tokens",
        "cache_creation_input_tokens",
        "cache_read_input_tokens",
        "total_tokens",
        "cost_usd"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "cache_creation_input_tokens": { "type": "integer", "minimum": 0 },
        "cache_read_input_tokens": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 },
        "cost_usd": { "type": "number", "minimum": 0 }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invocation_id", "ordinal", "role", "attempt", "prompt", "usage"],
      "properties": {
        "invocation_id": { "$ref": "#/$defs/nonEmpty" },
        "ordinal": { "type": "integer", "minimum": 1, "maximum": 4 },
        "role": { "enum": ["SPECIALIST", "REVIEWER"] },
        "attempt": { "enum": ["PRIMARY", "REPAIR"] },
        "prompt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sha256", "size"],
          "properties": {
            "sha256": { "$ref": "#/$defs/sha256" },
            "size": { "type": "integer", "minimum": 1 }
          }
        },
        "usage": { "$ref": "#/$defs/usage" }
      }
    },
    "callCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_calls",
        "specialist_calls",
        "reviewer_calls",
        "specialist_repairs",
        "reviewer_repairs",
        "model_retries"
      ],
      "properties": {
        "total_calls": { "type": "integer", "minimum": 1, "maximum": 4 },
        "specialist_calls": { "type": "integer", "minimum": 1, "maximum": 2 },
        "reviewer_calls": { "type": "integer", "minimum": 0, "maximum": 2 },
        "specialist_repairs": { "type": "integer", "minimum": 0, "maximum": 1 },
        "reviewer_repairs": { "type": "integer", "minimum": 0, "maximum": 1 },
        "model_retries": { "const": 0 }
      }
    },
    "specialistPrimaryInvocation": {
      "type": "object",
      "properties": {
        "role": { "const": "SPECIALIST" },
        "attempt": { "const": "PRIMARY" }
      }
    },
    "specialistRepairInvocation": {
      "type": "object",
      "properties": {
        "role": { "const": "SPECIALIST" },
        "attempt": { "const": "REPAIR" }
      }
    },
    "reviewerPrimaryInvocation": {
      "type": "object",
      "properties": {
        "role": { "const": "REVIEWER" },
        "attempt": { "const": "PRIMARY" }
      }
    },
    "reviewerRepairInvocation": {
      "type": "object",
      "properties": {
        "role": { "const": "REVIEWER" },
        "attempt": { "const": "REPAIR" }
      }
    },
    "specialistOnlyTopology": {
      "oneOf": [
        {
          "properties": {
            "invocations": {
              "minItems": 1,
              "maxItems": 1,
              "prefixItems": [
                { "$ref": "#/$defs/specialistPrimaryInvocation" }
              ]
            },
            "call_counts": {
              "properties": {
                "total_calls": { "const": 1 },
                "specialist_calls": { "const": 1 },
                "reviewer_calls": { "const": 0 },
                "specialist_repairs": { "const": 0 },
                "reviewer_repairs": { "const": 0 }
              }
            }
          }
        },
        {
          "properties": {
            "invocations": {
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                { "$ref": "#/$defs/specialistPrimaryInvocation" },
                { "$ref": "#/$defs/specialistRepairInvocation" }
              ]
            },
            "call_counts": {
              "properties": {
                "total_calls": { "const": 2 },
                "specialist_calls": { "const": 2 },
                "reviewer_calls": { "const": 0 },
                "specialist_repairs": { "const": 1 },
                "reviewer_repairs": { "const": 0 }
              }
            }
          }
        }
      ]
    },
    "blindConsensusTopology": {
      "oneOf": [
        {
          "properties": {
            "invocations": {
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                { "$ref": "#/$defs/specialistPrimaryInvocation" },
                { "$ref": "#/$defs/reviewerPrimaryInvocation" }
              ]
            },
            "call_counts": {
              "properties": {
                "total_calls": { "const": 2 },
                "specialist_calls": { "const": 1 },
                "reviewer_calls": { "const": 1 },
                "specialist_repairs": { "const": 0 },
                "reviewer_repairs": { "const": 0 }
              }
            }
          }
        },
        {
          "properties": {
            "invocations": {
              "minItems": 3,
              "maxItems": 3,
              "prefixItems": [
                { "$ref": "#/$defs/specialistPrimaryInvocation" },
                { "$ref": "#/$defs/specialistRepairInvocation" },
                { "$ref": "#/$defs/reviewerPrimaryInvocation" }
              ]
            },
            "call_counts": {
              "properties": {
                "total_calls": { "const": 3 },
                "specialist_calls": { "const": 2 },
                "reviewer_calls": { "const": 1 },
                "specialist_repairs": { "const": 1 },
                "reviewer_repairs": { "const": 0 }
              }
            }
          }
        },
        {
          "properties": {
            "invocations": {
              "minItems": 3,
              "maxItems": 3,
              "prefixItems": [
                { "$ref": "#/$defs/specialistPrimaryInvocation" },
                { "$ref": "#/$defs/reviewerPrimaryInvocation" },
                { "$ref": "#/$defs/reviewerRepairInvocation" }
              ]
            },
            "call_counts": {
              "properties": {
                "total_calls": { "const": 3 },
                "specialist_calls": { "const": 1 },
                "reviewer_calls": { "const": 2 },
                "specialist_repairs": { "const": 0 },
                "reviewer_repairs": { "const": 1 }
              }
            }
          }
        },
        {
          "properties": {
            "invocations": {
              "minItems": 4,
              "maxItems": 4,
              "prefixItems": [
                { "$ref": "#/$defs/specialistPrimaryInvocation" },
                { "$ref": "#/$defs/specialistRepairInvocation" },
                { "$ref": "#/$defs/reviewerPrimaryInvocation" },
                { "$ref": "#/$defs/reviewerRepairInvocation" }
              ]
            },
            "call_counts": {
              "properties": {
                "total_calls": { "const": 4 },
                "specialist_calls": { "const": 2 },
                "reviewer_calls": { "const": 2 },
                "specialist_repairs": { "const": 1 },
                "reviewer_repairs": { "const": 1 }
              }
            }
          }
        }
      ]
    },
    "methodsResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_sha256",
        "canonical_size",
        "case_id",
        "source_job_id",
        "result_ref",
        "evaluation_id",
        "status",
        "plan_ref",
        "evidence_graph_ref",
        "diagnostic_id"
      ],
      "properties": {
        "canonical_sha256": { "$ref": "#/$defs/sha256" },
        "canonical_size": { "type": "integer", "minimum": 1 },
        "case_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
        "source_job_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
        "result_ref": { "type": "string", "pattern": "^result-[a-f0-9]{64}$" },
        "evaluation_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
        "status": { "enum": ["RESOLVED", "UNRESOLVED", "FAILED"] },
        "plan_ref": { "type": "string", "pattern": "^plan-[a-f0-9]{64}$" },
        "evidence_graph_ref": { "type": "string", "pattern": "^graph-[a-f0-9]{64}$" },
        "diagnostic_id": { "type": "string", "pattern": "^diag-[a-f0-9]{64}$" }
      }
    }
  }
}
