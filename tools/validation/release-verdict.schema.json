{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xiaodao.local/schemas/evidence-v2/release-verdict.schema.json",
  "title": "Evidence V2 release verdict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_type",
    "status",
    "evaluation_mode",
    "source_snapshot_digest",
    "contract_manifest",
    "core_verdict",
    "scenario",
    "model_certs"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "receipt_type": { "const": "evidence-v2-release-verdict" },
    "status": { "const": "PASS" },
    "evaluation_mode": { "enum": ["SPECIALIST_ONLY", "BLIND_CONSENSUS"] },
    "source_snapshot_digest": { "$ref": "model-cert-input.schema.json#/$defs/sha256" },
    "contract_manifest": { "$ref": "model-cert-input.schema.json#/$defs/manifestBinding" },
    "core_verdict": { "$ref": "model-cert-input.schema.json#/$defs/coreBinding" },
    "scenario": { "$ref": "model-cert-input.schema.json#/$defs/scenario" },
    "model_certs": {
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/p1Cert" },
        { "$ref": "#/$defs/p2Cert" }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "evaluation_mode": { "const": "SPECIALIST_ONLY" } },
        "required": ["evaluation_mode"]
      },
      "then": {
        "properties": {
          "model_certs": {
            "prefixItems": [
              { "properties": { "evaluation_mode": { "const": "SPECIALIST_ONLY" } } },
              { "properties": { "evaluation_mode": { "const": "SPECIALIST_ONLY" } } }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "evaluation_mode": { "const": "BLIND_CONSENSUS" } },
        "required": ["evaluation_mode"]
      },
      "then": {
        "properties": {
          "model_certs": {
            "prefixItems": [
              { "properties": { "evaluation_mode": { "const": "BLIND_CONSENSUS" } } },
              { "properties": { "evaluation_mode": { "const": "BLIND_CONSENSUS" } } }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "baseCert": {
      "type": "object",
      "additionalProperties": false,
      "required": ["certification_target", "evaluation_mode", "path", "sha256", "provider", "model", "scenario_oracle", "methods_result"],
      "properties": {
        "certification_target": { "enum": ["P1", "P2"] },
        "evaluation_mode": { "enum": ["SPECIALIST_ONLY", "BLIND_CONSENSUS"] },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "model-cert-input.schema.json#/$defs/sha256" },
        "provider": { "$ref": "model-cert-input.schema.json#/$defs/provider" },
        "model": { "$ref": "model-cert-input.schema.json#/$defs/model" },
        "scenario_oracle": { "$ref": "model-cert-input.schema.json#/$defs/scenarioOracleBinding" },
        "methods_result": { "$ref": "model-cert-input.schema.json#/$defs/methodsResult" }
      }
    },
    "p1Cert": {
      "allOf": [
        { "$ref": "#/$defs/baseCert" },
        {
          "type": "object",
          "properties": {
            "certification_target": { "const": "P1" },
            "provider": {
              "properties": {
                "id": { "const": "deepseek" },
                "transport": { "const": "claude-code-compatible-api" }
              }
            },
            "model": {
              "properties": {
                "id": { "const": "deepseek-v4-flash[1m]" },
                "revision": { "$ref": "model-cert-input.schema.json#/$defs/sha256" },
                "revision_source": { "const": "settings-fingerprint" }
              }
            }
          },
          "required": ["certification_target"]
        }
      ]
    },
    "p2Cert": {
      "allOf": [
        { "$ref": "#/$defs/baseCert" },
        {
          "type": "object",
          "properties": {
            "certification_target": { "const": "P2" },
            "provider": {
              "properties": {
                "id": { "const": "openai" },
                "transport": { "const": "codex-app-server" }
              }
            },
            "model": {
              "properties": {
                "id": { "const": "gpt-5.6-luna" },
                "revision": { "$ref": "model-cert-input.schema.json#/$defs/sha256" },
                "revision_source": { "const": "frozen-codex-cli-and-app-server-runtime-identity" }
              }
            }
          },
          "required": ["certification_target"]
        }
      ]
    }
  }
}
