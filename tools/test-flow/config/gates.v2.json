    "framework.config": {
      "kind": "node-test",
      "test_files": ["tools/test-flow/tests/config-contract.test.mjs"],
      "min_passed": 1,
      "evidence": ["node-test.tap"]
    },
    "framework.node-tests": {
      "kind": "node-test",
      "test_glob": "tools/test-flow/tests/*.test.mjs",
      "exclude": ["tools/test-flow/tests/config-contract.test.mjs", "tools/test-flow/tests/docs-drift.test.mjs"],
