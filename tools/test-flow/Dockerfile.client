ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG BASE_IMAGE
ARG CHROME_HEADLESS_SHELL_VERSION
ARG CHROME_HEADLESS_SHELL_ARCHIVE_SHA256
ARG CHROME_HEADLESS_SHELL_EXECUTABLE_SHA256

ENV DEBIAN_FRONTEND=noninteractive \
    TEST_FLOW_CHROME_HEADLESS_SHELL=/opt/chrome-headless-shell/chrome-headless-shell

RUN apt-get -o Acquire::Retries=5 update \
    && apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
      fonts-liberation libasound2t64 libatk-bridge2.0-0 libatk1.0-0 libatspi2.0-0 \
      libcairo2 libcups2 libdbus-1-3 libdrm2 libexpat1 libgbm1 \
      libglib2.0-0 libgtk-3-0 libnspr4 libnss3 libpango-1.0-0 \
      libudev1 libvulkan1 libx11-6 libxcb1 libxcomposite1 libxdamage1 \
      libxext6 libxfixes3 libxkbcommon0 libxrandr2 wget xdg-utils \
    && rm -rf /var/lib/apt/lists/*

COPY --from=chromeheadlessshellcache . /opt/chrome-headless-shell

RUN echo "${CHROME_HEADLESS_SHELL_EXECUTABLE_SHA256}  /opt/chrome-headless-shell/chrome-headless-shell" | sha256sum -c - \
    && actual_version="$(/opt/chrome-headless-shell/chrome-headless-shell --version | sed 's/[[:space:]]*$//')" \
    && test "$actual_version" = "Google Chrome for Testing ${CHROME_HEADLESS_SHELL_VERSION}" \
    && test -n "${CHROME_HEADLESS_SHELL_ARCHIVE_SHA256}"

LABEL problem-locator.e2e.role="linux-client" \
      problem-locator.e2e.chrome-headless-shell-product="Chrome Headless Shell for Testing" \
      problem-locator.e2e.chrome-headless-shell-version="${CHROME_HEADLESS_SHELL_VERSION}" \
      problem-locator.e2e.chrome-headless-shell-sha256="${CHROME_HEADLESS_SHELL_EXECUTABLE_SHA256}" \
      problem-locator.e2e.chrome-headless-shell-archive-sha256="${CHROME_HEADLESS_SHELL_ARCHIVE_SHA256}" \
      problem-locator.e2e.contains-secrets="false"

WORKDIR /workspace
CMD ["sleep", "infinity"]
