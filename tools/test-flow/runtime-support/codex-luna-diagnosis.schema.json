{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "status",
    "confirmed_methods",
    "candidate_methods",
    "evidence",
    "limitations",
    "safety_notes",
    "logparse_receipt_sha256"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 2 },
    "scenario_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["CONFIRMED", "PARTIAL", "INSUFFICIENT"] },
    "confirmed_methods": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "candidate_methods": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["method_id", "summary", "identity_tokens", "sources"],
        "properties": {
          "method_id": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "identity_tokens": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_id", "line_number", "marker", "line"],
              "properties": {
                "source_id": { "type": "string", "minLength": 1 },
                "line_number": { "type": "integer", "minimum": 1 },
                "marker": { "type": "string", "minLength": 1 },
                "line": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "safety_notes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "logparse_receipt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
