{
  "schema_version": 1,
  "registration_id": "rpc-timeout-methods-v1",
  "version": "1.0.0",
  "capability": "Diagnose RPC timeouts from frozen client and server logs using authored evidence methods.",
  "deployment_scope": "PRODUCTION",
  "summary": "Release-only product registration for the Wiki-derived RPC timeout Methods Skill.",
  "package": {
    "relative_path": "package/diagnose-rpc-timeout",
    "skill_name": "diagnose-rpc-timeout",
    "source_wiki_sha256": "eb39edf220d0eed91ae03eb712efd8974a5e5c82c3deed035c236a0d1bf28aab"
  },
  "runtime": {
    "diagnose": {
      "agent_profile_id": "agent-profile/specialist",
      "tool_bundle_id": "tool-bundle/diagnose",
      "context_policy_id": "context-policy/diagnose",
      "output_contract_id": "output-contract/diagnose"
    },
    "review": {
      "agent_profile_id": "agent-profile/reviewer",
      "tool_bundle_id": "tool-bundle/review",
      "context_policy_id": "context-policy/review",
      "output_contract_id": "output-contract/review"
    },
    "preprocessing": {
      "requires_logparse": true,
      "logparse_product": "rpc-skill-feasibility",
      "roles": [
        {
          "label": "client",
          "description": "RPC client process logs that contain timeout and late-response evidence.",
          "presence": "REQUIRED",
          "source_reference": "Wiki 参数说明中的客户端进程信息。"
        },
        {
          "label": "server",
          "description": "RPC server process logs that contain API execution and queue-history evidence.",
          "presence": "REQUIRED",
          "source_reference": "Wiki 参数说明中的服务端进程信息。"
        }
      ],
      "logparse_plan": {
        "attachment_requirement": "log_archive",
        "problem_time_binding": {"source": "USER_FACT", "name": "problem_time"},
        "anchors": [
          {
            "label": "client",
            "module": {"source": "SKILL_FIXED", "value": "rpc"},
            "slot": {"source": "SKILL_FIXED", "value": "1"},
            "process_name": {"source": "USER_FACT", "name": "client_process"},
            "pid": null
          },
          {
            "label": "server",
            "module": {"source": "SKILL_FIXED", "value": "rpc"},
            "slot": {"source": "SKILL_FIXED", "value": "1"},
            "process_name": {"source": "USER_FACT", "name": "server_process"},
            "pid": null
          }
        ]
      }
    }
  }
}
