# Problem Locator 8.2（PostgreSQL）：路径使用绝对路径，SQLite 迁移使用全新 DATA_ROOT。
DATA_ROOT=/absolute/path/to/problem-locator-data
# 使用独立的 PostgreSQL 15 或更新版本数据库，建议采用所选主版本最新的维护小版本。
# 替换账号、密码与服务器地址。
DATABASE_URL=postgresql://problem_locator:change-me@127.0.0.1:5432/problem_locator
# 连接池上限为 2–32；默认 8，需结合数据库连接总量调整。
DATABASE_POOL_SIZE=8
# 非 Web 历史和删除凭据默认保留 30 天；Web 会话正文与报告不自动删除。
HISTORY_RETENTION_DAYS=30
# Web 日志资源在轮次完成后保留 15 天，空间不足时可提前清理已完成轮次；支持 1–3650 天。
WEB_RESOURCE_RETENTION_DAYS=15
# 磁盘余量低于字节值与比例中的较大值时回收，达到目标余量后停止；修改后重启生效。
RESOURCE_DISK_LOW_FREE_BYTES=10737418240
RESOURCE_DISK_TARGET_FREE_BYTES=21474836480
RESOURCE_DISK_LOW_FREE_PERCENT=10
RESOURCE_DISK_TARGET_FREE_PERCENT=15
# xiaodao 从 Cookie 的 sessionid 查询 Redis，并读取 user.userid 作为用户工号。
WEBSITE_AUTH_MODE=redis
# 预留 Redis 内网 IP 或主机名，部署时填写；不含协议和端口。
WEBSITE_REDIS_HOST=
WEBSITE_REDIS_PORT=6379
WEBSITE_REDIS_DB=0
# WEBSITE_REDIS_USERNAME=
# WEBSITE_REDIS_PASSWORD=
WEBSITE_REDIS_SSL=false
WEBSITE_SESSION_COOKIE_NAME=sessionid
WEBSITE_OWNER_NAMESPACE=xiaodao-website
PUBLIC_BASE_URL=http://127.0.0.1:8000
BIND_HOST=127.0.0.1
PORT=8000
CLAUDE_COMMAND=claude
# 可按角色覆盖 Agent 命令；取消注释后才会覆盖 CLAUDE_COMMAND。
# ROUTE_CLAUDE_COMMAND=claude --model <低延迟模型>
# DIAGNOSE_CLAUDE_COMMAND=claude --model <诊断模型>
# 网站对话整理默认沿用 ROUTE_CLAUDE_COMMAND。
# INTAKE_CLAUDE_COMMAND=claude --model <低延迟模型>
SKILL_DIR=/absolute/path/to/problem-locator/.claude/skills
GENERIC_SKILL_NAME=generic-problem-locator
# 仅供旧版通用 Job 的 Logparse 准备使用；新通用任务直接读取日志，不依赖此设置。
GENERIC_LOGPARSE_PRODUCT=default
# 仅控制通用经验提炼和召回，不影响通用和专用 direct 的 V2 Markdown 报告赞踩。
# 实际通用 Skill 完成接入验证后再启用。
GENERIC_MEMORY_ENABLED=false
# 报告追问默认关闭；启用后统一使用原生会话续接，部署验收后再开启。
REPORT_FOLLOWUP_ENABLED=false
# 单次追问执行上限，单位秒；默认 600，允许 1–1800，修改后重启生效。
REPORT_FOLLOWUP_TIMEOUT_SECONDS=600
# 日志快照单份最多 1 GiB，总量默认 5 GiB，不占原诊断额度。
REPORT_FOLLOWUP_SNAPSHOT_BYTES=1073741824
REPORT_FOLLOWUP_STORAGE_BYTES=5368709120
# 仅通用定位且没有依赖 Logparse 的专用 Skill 时，以下三项可以全部省略。
# 专用定位或恢复旧 Logparse 任务时仍需配置；REPO 与 CONFIG_PATH 必须成对填写。
LOGPARSE_REPO=/absolute/path/to/pinned/logparse
LOGPARSE_CONFIG_PATH=/absolute/path/to/pinned/logparse/config.yaml
LOGPARSE_PYTHON=/absolute/path/to/pinned/logparse/.venv/bin/python
DFX_LOG_LEVEL=INFO
DFX_LOG_DIR=/absolute/path/to/problem-locator-logs
SPECIALIZED_REVIEWER_ENABLED=false
# off 直接交付 Skill 正文，并强制关闭独立审核；advisory/strict 恢复原交付策略。
METHODS_EVIDENCE_VALIDATION=off
ROUTE_WORKERS=1
DIAGNOSE_WORKERS=2
LOGPARSE_CONCURRENCY=1
ARCHIVE_WORKERS=1
