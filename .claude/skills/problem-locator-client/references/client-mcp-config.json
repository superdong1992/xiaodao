{
  "mcpServers": {
    "problem-locator": {
      "type": "stdio",
      "command": "problem-locator-client-proxy",
      "args": [],
      "env": {
        "PROBLEM_LOCATOR_MCP_URL": "${PROBLEM_LOCATOR_MCP_URL}",
        "PROBLEM_LOCATOR_CLIENT_DFX_LOG_FILE": "${PROBLEM_LOCATOR_CLIENT_DFX_LOG_FILE:-.problem-locator/client-dfx.jsonl}",
        "PROBLEM_LOCATOR_CLIENT_DFX_LOG_LEVEL": "${PROBLEM_LOCATOR_CLIENT_DFX_LOG_LEVEL:-INFO}",
        "PROBLEM_LOCATOR_CLIENT_SCHEMA_MODE": "${PROBLEM_LOCATOR_CLIENT_SCHEMA_MODE:-strict}"
      }
    }
  }
}
