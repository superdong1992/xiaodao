{
  "schema_version": 6,
  "generator_version": "6.0.0",
  "id": "diagnose-neutral-event-chain",
  "version": "6.0.0",
  "capability": "neutral-event-chain",
  "deployment_scope": "TEST_ONLY",
  "summary": "定位中性双端事件链中的超预算与观测不确定性",
  "chinese_title": "中性事件链定位",
  "module_name": "neutral",
  "problem_scope": "根据固定日志快照验证事件 A 的本地耗时、事件 A 与事件 B 的数值关系及跨时钟先后关系，并在观测受损时保留部分结论。",
  "roles": [
    {
      "label": "source",
      "description": "产生事件 A 多行记录的源进程",
      "presence": "REQUIRED",
      "source_reference": "已确认的 source 角色说明：产生事件 A 多行记录的源进程",
      "confirmed": true
    },
    {
      "label": "observer",
      "description": "产生事件 B 观测记录的观察进程",
      "presence": "REQUIRED",
      "source_reference": "已确认的 observer 角色说明：产生事件 B 观测记录的观察进程",
      "confirmed": true
    }
  ],
  "requirements": [
    {
      "name": "correlation_id",
      "kind": "INPUT",
      "stage": "AFTER_LOGPARSE",
      "fulfillment_source": "USER_FACT",
      "prompt": "请提供用于关联事件 A 与事件 B 的标识。",
      "constraints": {
        "value_type": "STRING",
        "min_utf8_bytes": 1,
        "max_utf8_bytes": 256,
        "pattern": null,
        "allowed_values": []
      },
      "supplement_policy": "MISSING_ONLY",
      "requiredness": "REQUIRED",
      "activation_condition": null,
      "source_reference": "已确认的 Wiki 参数定义：请提供用于关联事件 A 与事件 B 的标识。",
      "confirmed": true
    }
  ],
  "logparse_plan": {
    "anchors": [
      {
        "label": "source",
        "module": {
          "source": "SKILL_FIXED",
          "value": "neutral"
        }
      },
      {
        "label": "observer",
        "module": {
          "source": "SKILL_FIXED",
          "value": "neutral"
        }
      }
    ]
  },
  "verification_contract": {
    "schema_version": 2,
    "observation_policies": [
      {
        "id": "default_suppression",
        "kind": "SUPPRESSION",
        "scope": "process_instance",
        "key_fields": [
          "correlation_id"
        ],
        "window_ms": 60000,
        "max_observed": null,
        "boundary": "CLOSED_OPEN"
      },
      {
        "id": "burst_limit",
        "kind": "RATE_LIMIT",
        "scope": "process_instance",
        "key_fields": [
          "correlation_id"
        ],
        "window_ms": 120000,
        "max_observed": 1,
        "boundary": "CLOSED_OPEN"
      }
    ],
    "event_extractors": [
      {
        "id": "event_a_block",
        "anchor": "source",
        "members": [
          {
            "line_pattern": "EVENT_A begin key:(?P<correlation_id>[^, ]+), start:(?P<start_us>\\d+), budget:(?P<budget_ms>\\d+)",
            "match_mode": "SEARCH"
          },
          {
            "line_pattern": "EVENT_A sample key:(?P<correlation_id>[^, ]+), load:(?P<load_count>\\d+)",
            "match_mode": "SEARCH"
          },
          {
            "line_pattern": "EVENT_A finish key:(?P<correlation_id>[^, ]+), finish:(?P<finish_us>\\d+)",
            "match_mode": "SEARCH"
          }
        ],
        "fields": [
          {
            "name": "correlation_id",
            "type": "STRING",
            "unit": null,
            "clock_domain": null
          },
          {
            "name": "start_us",
            "type": "INTEGER",
            "unit": "MICROSECOND",
            "clock_domain": "source_clock"
          },
          {
            "name": "budget_ms",
            "type": "INTEGER",
            "unit": "MILLISECOND",
            "clock_domain": null
          },
          {
            "name": "load_count",
            "type": "INTEGER",
            "unit": "COUNT",
            "clock_domain": null
          },
          {
            "name": "finish_us",
            "type": "INTEGER",
            "unit": "MICROSECOND",
            "clock_domain": "source_clock"
          }
        ],
        "timestamp_field": "finish_us",
        "group_by": [
          "correlation_id"
        ],
        "selectors": [
          {
            "field": "correlation_id",
            "operator": "EQUALS",
            "value": {
              "source": "USER_FACT",
              "name": "correlation_id"
            }
          }
        ],
        "max_gap_lines": 2,
        "min_matches": 0,
        "max_matches": null,
        "observation_policy_ids": [
          "default_suppression",
          "burst_limit"
        ]
      },
      {
        "id": "event_b_marker",
        "anchor": "observer",
        "members": [
          {
            "line_pattern": "EVENT_B observed key:(?P<correlation_id>[^, ]+), observed:(?P<observed_us>\\d+), threshold:(?P<threshold_count>\\d+)",
            "match_mode": "SEARCH"
          }
        ],
        "fields": [
          {
            "name": "correlation_id",
            "type": "STRING",
            "unit": null,
            "clock_domain": null
          },
          {
            "name": "observed_us",
            "type": "INTEGER",
            "unit": "MICROSECOND",
            "clock_domain": "observer_clock"
          },
          {
            "name": "threshold_count",
            "type": "INTEGER",
            "unit": "COUNT",
            "clock_domain": null
          }
        ],
        "timestamp_field": "observed_us",
        "group_by": [
          "correlation_id"
        ],
        "selectors": [
          {
            "field": "correlation_id",
            "operator": "EQUALS",
            "value": {
              "source": "USER_FACT",
              "name": "correlation_id"
            }
          }
        ],
        "max_gap_lines": 0,
        "min_matches": 0,
        "max_matches": null,
        "observation_policy_ids": [
          "default_suppression"
        ]
      }
    ],
    "rules": [
      {
        "id": "event_a_present",
        "kind": "EVENT_PRESENT",
        "description": "固定快照中存在目标事件 A 多行记录。",
        "depends_on": [],
        "remediation_requirements": [],
        "parameters": {
          "event": "event_a_block"
        }
      },
      {
        "id": "event_b_present",
        "kind": "EVENT_PRESENT",
        "description": "固定快照中存在目标事件 B 观测记录。",
        "depends_on": [],
        "remediation_requirements": [],
        "parameters": {
          "event": "event_b_marker"
        }
      },
      {
        "id": "local_duration_over_budget",
        "kind": "NUMERIC_COMPARE",
        "description": "事件 A 在同一源时钟下的本地耗时超过记录中的预算。",
        "depends_on": [
          "event_a_present"
        ],
        "remediation_requirements": [],
        "parameters": {
          "left": {
            "kind": "SUBTRACT",
            "left": {
              "kind": "FIELD",
              "event": "event_a_block",
              "field": "finish_us"
            },
            "right": {
              "kind": "FIELD",
              "event": "event_a_block",
              "field": "start_us"
            }
          },
          "operator": "GT",
          "right": {
            "kind": "CONVERT",
            "operand": {
              "kind": "FIELD",
              "event": "event_a_block",
              "field": "budget_ms"
            },
            "unit": "MICROSECOND"
          },
          "quantifier": "EXISTS",
          "joins": [],
          "clock_tolerance_ms": 0
        }
      },
      {
        "id": "load_exceeds_threshold",
        "kind": "NUMERIC_COMPARE",
        "description": "同一关联标识下事件 A 的负载计数超过事件 B 记录的阈值。",
        "depends_on": [
          "event_a_present",
          "event_b_present"
        ],
        "remediation_requirements": [],
        "parameters": {
          "left": {
            "kind": "FIELD",
            "event": "event_a_block",
            "field": "load_count"
          },
          "operator": "GT",
          "right": {
            "kind": "FIELD",
            "event": "event_b_marker",
            "field": "threshold_count"
          },
          "quantifier": "EXISTS",
          "joins": [
            {
              "members": [
                {
                  "event": "event_a_block",
                  "field": "correlation_id"
                },
                {
                  "event": "event_b_marker",
                  "field": "correlation_id"
                }
              ]
            }
          ],
          "clock_tolerance_ms": 0
        }
      },
      {
        "id": "observer_after_finish",
        "kind": "NUMERIC_COMPARE",
        "description": "事件 B 的观察时间在显式跨时钟容差之外晚于事件 A 的完成时间。",
        "depends_on": [
          "event_a_present",
          "event_b_present"
        ],
        "remediation_requirements": [],
        "parameters": {
          "left": {
            "kind": "SUBTRACT",
            "left": {
              "kind": "FIELD",
              "event": "event_b_marker",
              "field": "observed_us"
            },
            "right": {
              "kind": "FIELD",
              "event": "event_a_block",
              "field": "finish_us"
            }
          },
          "operator": "GT",
          "right": {
            "kind": "CONST",
            "value": 0,
            "unit": "MICROSECOND"
          },
          "quantifier": "EXISTS",
          "joins": [
            {
              "members": [
                {
                  "event": "event_a_block",
                  "field": "correlation_id"
                },
                {
                  "event": "event_b_marker",
                  "field": "correlation_id"
                }
              ]
            }
          ],
          "clock_tolerance_ms": 50
        }
      },
      {
        "id": "complete_chain_supported",
        "kind": "SEMANTIC_CAUSALITY",
        "description": "两名 Agent 独立判断完整事件链是否支持本地超预算与观察侧阈值共同构成贡献因素。",
        "depends_on": [
          "local_duration_over_budget",
          "load_exceeds_threshold",
          "observer_after_finish"
        ],
        "remediation_requirements": [],
        "parameters": {
          "assertion": "同一固定快照中，关联一致的事件 A 与事件 B 正向证据共同支持本地超预算和观察侧阈值是两个贡献因素。",
          "evidence_events": [
            "event_a_block",
            "event_b_marker"
          ]
        }
      },
      {
        "id": "partial_source_overrun_supported",
        "kind": "SEMANTIC_CAUSALITY",
        "description": "两名 Agent 独立判断事件 A 是否足以支持本地超预算的部分结论。",
        "depends_on": [
          "event_a_present",
          "local_duration_over_budget"
        ],
        "remediation_requirements": [],
        "parameters": {
          "assertion": "事件 A 的正向多行证据足以确认本地超预算，但受损观测或跨时钟不确定性使观察侧因素仍未决。",
          "evidence_events": [
            "event_a_block"
          ]
        }
      }
    ],
    "terminal_paths": [
      {
        "id": "complete_event_chain",
        "resolution_status": "COMPLETE",
        "condition": {
          "any_of": [
            {
              "all_of": [
                {
                  "rule_id": "complete_chain_supported",
                  "result": "PASS"
                }
              ]
            }
          ]
        }
      },
      {
        "id": "partial_observation_uncertain",
        "resolution_status": "PARTIAL",
        "condition": {
          "any_of": [
            {
              "all_of": [
                {
                  "rule_id": "event_b_present",
                  "result": "UNKNOWN"
                },
                {
                  "rule_id": "partial_source_overrun_supported",
                  "result": "PASS"
                }
              ]
            },
            {
              "all_of": [
                {
                  "rule_id": "observer_after_finish",
                  "result": "UNKNOWN"
                },
                {
                  "rule_id": "partial_source_overrun_supported",
                  "result": "PASS"
                }
              ]
            }
          ]
        }
      },
      {
        "id": "none",
        "resolution_status": "NONE",
        "condition": {
          "any_of": [
            {
              "all_of": []
            }
          ]
        }
      }
    ]
  },
  "time_characteristics": [
    "事件 A 的开始与完成时间属于 source_clock，事件 B 的观察时间属于 observer_clock。",
    "跨 source_clock 与 observer_clock 的比较使用显式 50 毫秒容差，同一时钟域比较使用 0 容差。",
    "只判断固定快照，不补历史日志、不等待未来日志且不启动监控。"
  ],
  "analysis_steps": [
    "按关联标识组装事件 A 的三行有界记录。",
    "验证事件 A 的同钟域耗时是否超过记录预算。",
    "关联事件 B 后比较负载阈值并应用跨时钟容差。",
    "按顺序选择 COMPLETE、PARTIAL 或 NONE 终止路径。"
  ],
  "judgement_rules": [
    "受损观测不否定已观察到的正向事件，但日志缺失与有上界计数只能形成 UNKNOWN。",
    "只有事件 A 与事件 B 的关联、数值关系和跨时钟关系均得到支持时才选择完整结论。",
    "固定快照只支持事件 A 本地超预算时保留部分结论，不推断观察侧因素。"
  ],
  "output_requirements": [
    "分别说明本地超预算与观察侧阈值的证据和规则。",
    "部分结论必须说明受损观测或跨时钟容差留下的不确定性。",
    "所有因素必须绑定原始事件证据与 supporting rule IDs。"
  ],
  "assumptions": [
    "关联标识只在 anchor 确定的进程实例内使用，不假设其全局唯一。",
    "EVENT_A 与 EVENT_B 文本仅表示测试专用的稳定中性消息体。"
  ],
  "requires_logparse": true
}
