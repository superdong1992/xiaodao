{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"Public server projection of one Evidence V2 terminal result.\n\nThis deliberately contains only stable terminal identities and mechanically\nconfirmed refs.  Specialist and Reviewer drafts, verdict arrays, and their\nfree-form reasons are not part of the public Case contract.","properties":{"case_id":{"pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$","title":"Case Id","type":"string"},"confirmed_evaluation_refs":{"items":{"pattern":"^eval-[0-9a-f]{64}$","type":"string"},"title":"Confirmed Evaluation Refs","type":"array"},"confirmed_event_refs":{"items":{"pattern":"^event-[0-9a-f]{64}$","type":"string"},"title":"Confirmed Event Refs","type":"array"},"confirmed_hit_refs":{"items":{"pattern":"^hit-[0-9a-f]{64}$","type":"string"},"title":"Confirmed Hit Refs","type":"array"},"confirmed_method_ids":{"items":{"pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$","type":"string"},"title":"Confirmed Method Ids","type":"array"},"diagnostic_evaluation_ref":{"anyOf":[{"pattern":"^eval-[0-9a-f]{64}$","type":"string"},{"type":"null"}],"title":"Diagnostic Evaluation Ref"},"diagnostic_id":{"pattern":"^diag-[0-9a-f]{64}$","title":"Diagnostic Id","type":"string"},"evaluation_id":{"pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$","title":"Evaluation Id","type":"string"},"evidence_graph_ref":{"pattern":"^graph-[0-9a-f]{64}$","title":"Evidence Graph Ref","type":"string"},"limitations":{"items":{"maxLength":65536,"minLength":1,"type":"string"},"title":"Limitations","type":"array"},"plan_ref":{"pattern":"^plan-[0-9a-f]{64}$","title":"Plan Ref","type":"string"},"reason_code":{"anyOf":[{"enum":["SPECIALIST_PROTOCOL_REPAIR_EXHAUSTED","REVIEWER_PROTOCOL_REPAIR_EXHAUSTED","SPECIALIST_SEMANTIC_INVALID","REVIEWER_SEMANTIC_INVALID","SPECIALIST_MODEL_EXECUTION_FAILED","REVIEWER_MODEL_EXECUTION_FAILED","SPECIALIST_REVIEWER_DISAGREEMENT","INCOMPLETE_EVALUATION","NO_CONFIRMED_METHOD","NO_MATCHING_METHOD_EVIDENCE","RESOURCE_SNAPSHOT_DRIFT","SERVER_INVARIANT_VIOLATION","AUDIT_ARCHIVE_FAILED"],"type":"string"},{"type":"null"}],"title":"Reason Code"},"reasons":{"items":{"maxLength":65536,"minLength":1,"type":"string"},"title":"Reasons","type":"array"},"result_ref":{"pattern":"^result-[0-9a-f]{64}$","title":"Result Ref","type":"string"},"schema_version":{"const":2,"title":"Schema Version","type":"integer"},"source_job_id":{"pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$","title":"Source Job Id","type":"string"},"status":{"enum":["RESOLVED","UNRESOLVED","FAILED"],"title":"Status","type":"string"}},"required":["schema_version","case_id","source_job_id","result_ref","evaluation_id","status","plan_ref","evidence_graph_ref","reason_code","diagnostic_id","diagnostic_evaluation_ref","confirmed_evaluation_refs","confirmed_method_ids","confirmed_event_refs","confirmed_hit_refs","limitations","reasons"],"title":"MethodsTerminalProjectionV2","type":"object"}
