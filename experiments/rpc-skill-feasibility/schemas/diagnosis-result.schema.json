{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "status",
    "confirmed_methods",
    "candidate_methods",
    "evidence",
    "limitations",
    "safety_notes",
    "logparse_receipt_sha256"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "scenario_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "CONFIRMED",
        "PARTIAL",
        "INSUFFICIENT"
      ]
    },
    "confirmed_methods": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "candidate_methods": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "method_id",
          "anchor",
          "marker",
          "summary"
        ],
        "properties": {
          "method_id": {
            "type": "string"
          },
          "anchor": {
            "type": "string",
            "enum": [
              "client",
              "server"
            ]
          },
          "marker": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "safety_notes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "logparse_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
